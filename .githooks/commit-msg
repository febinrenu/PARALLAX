#!/bin/sh
# Keeps commit messages to plain human text: no co-author trailers, generated-by lines or session links.
# Activate once per clone:  git config core.hooksPath .githooks

msg_file="$1"
tmp_file="${msg_file}.tmp"

grep -viE '^[[:space:]]*co-authored-by:|^[[:space:]]*[a-z-]*-session:|generated with ' "$msg_file" > "$tmp_file" || true
mv "$tmp_file" "$msg_file"
exit 0
