# Copy to .env (gitignored) and fill in your own values. Never commit .env.
GROQ_KEY_EXTRACT=
GROQ_KEY_REPORT=
GROQ_KEY_JUDGE=
GROQ_KEY_AUDIO=
HF_TOKEN=
KAGGLE_API_TOKEN=
MEDGEMMA_URL=http://localhost:8001

# CXR reader (backend/medproof/readers/cxr_config.py). Blank = use the code default.
MEDPROOF_CXR_WEIGHTS=  # default: densenet121-res224-all
MEDPROOF_CXR_CAM=      # default: gradcam++
MEDPROOF_DEVICE=       # default: cpu

# Pipeline orchestrator (backend/medproof/core/config.py). Blank = use the code default
# (a temp directory for cache/artifacts, so a fresh clone never accumulates files in-repo).
MEDPROOF_CACHE_DIR=
MEDPROOF_ARTIFACT_DIR=
MEDPROOF_STAGE_TIMEOUT_S=  # default: 20.0
